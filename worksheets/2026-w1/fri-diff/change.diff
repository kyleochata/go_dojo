+// Persist writes every live session to path as JSON.
+func (s *Store) Persist(path string) error {
+	s.mu.RLock()
+	defer s.mu.RUnlock()
+
+	f, err := os.Create(path)
+	if err != nil {
+		return fmt.Errorf("sessions: persist %s: %w", path, err)
+	}
+	defer f.Close()
+
+	all := make([]*Session, 0, len(s.byID))
+	for _, sess := range s.byID {
+		all = append(all, sess)
+	}
+	if err := json.NewEncoder(f).Encode(all); err != nil {
+		return fmt.Errorf("sessions: encode %s: %w", path, err)
+	}
+	return nil
+}
+
+// Restore replaces the store's contents with the sessions in path.
+func (s *Store) Restore(path string) error {
+	b, err := os.ReadFile(path)
+	if err != nil {
+		return fmt.Errorf("sessions: restore %s: %v", path, err)
+	}
+	var all []*Session
+	if err := json.Unmarshal(b, &all); err != nil {
+		return fmt.Errorf("sessions: decode %s: %w", path, err)
+	}
+
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	s.byID = make(map[string]*Session, len(all))
+	for _, sess := range all {
+		s.byID[sess.Token] = sess
+	}
+	return nil
+}
