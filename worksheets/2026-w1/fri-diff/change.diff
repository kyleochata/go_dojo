 type Store struct {
 	mu   sync.RWMutex
 	byID map[string]*Session
+	ttl  time.Duration
+	stop chan struct{}
+	once sync.Once
 }
 
 func New() *Store {
 	return &Store{byID: make(map[string]*Session)}
 }
 
+// NewWithTTL returns a store that expires sessions older than ttl and
+// sweeps them out every interval. Call Close when done with it.
+func NewWithTTL(ttl, interval time.Duration) *Store {
+	s := &Store{
+		byID: make(map[string]*Session),
+		ttl:  ttl,
+		stop: make(chan struct{}),
+	}
+	go s.sweepLoop(interval)
+	return s
+}
+
+func (s *Store) sweepLoop(interval time.Duration) {
+	t := time.NewTicker(interval)
+	defer t.Stop()
+	for {
+		select {
+		case <-t.C:
+			s.Sweep()
+		case <-s.stop:
+			return
+		}
+	}
+}
+
+// Sweep drops every expired session.
+func (s *Store) Sweep() int {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if s.ttl <= 0 {
+		return 0
+	}
+	cutoff := time.Now().Add(-s.ttl)
+	n := 0
+	for token, sess := range s.byID {
+		if sess.Created.Before(cutoff) {
+			delete(s.byID, token)
+			n++
+		}
+	}
+	return n
+}
+
+// Close stops the sweeper.
+func (s *Store) Close() {
+	s.once.Do(func() {
+		if s.stop != nil {
+			close(s.stop)
+		}
+	})
+}
